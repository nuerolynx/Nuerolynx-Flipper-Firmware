App(
    appid="smart_meter_monitor",
    name="NLX Meter Monitor",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="smart_meter_app",
    requires=["gui", "notification"],
    stack_size=3 * 1024,
    sources=["*.c"],
    fap_category="Sub-GHz",
    fap_version=(1, 11),
    fap_icon="icons/nlx_menu_10px.png",
    fap_description="Passive multi-band smart-meter RF activity monitor",
    fap_author="UberGuidoZ / Nuerolynx integration",
    fap_weburl="https://github.com/UberGuidoZ/Flipper",
)
